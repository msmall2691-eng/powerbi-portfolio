/// Learning outside the degree.
table Credentials
	lineageTag: 6d42afe2-7d3a-c23b-04fa-4fd1b35e5bb9

	measure 'Credential Count' = COUNTROWS(Credentials)
		formatString: 0
		lineageTag: 09309326-6f83-7cce-c01d-07835647d863

	column Credential
		dataType: string
		lineageTag: 3a366385-6f20-a67a-553a-8c5c7bb2c094
		summarizeBy: none
		sourceColumn: Credential

		annotation SummarizationSetBy = User

	column Provider
		dataType: string
		lineageTag: 9f57acfa-46e5-8519-a399-b97c5ead164e
		summarizeBy: none
		sourceColumn: Provider

		annotation SummarizationSetBy = User

	column 'Credential Status'
		dataType: string
		lineageTag: 2a6e4955-2f34-23eb-56f2-4b84000e6f08
		summarizeBy: none
		sourceColumn: Credential Status

		annotation SummarizationSetBy = User

	column Timing
		dataType: string
		lineageTag: 07af6047-da19-e524-7559-f49812680f99
		summarizeBy: none
		sourceColumn: Timing

		annotation SummarizationSetBy = User

	column Focus
		dataType: string
		lineageTag: a9b379d3-1032-5ee1-5968-535074eb3b39
		summarizeBy: none
		sourceColumn: Focus

		annotation SummarizationSetBy = User

	partition Credentials = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Credential", type text}, {"Provider", type text}, {"Credential Status", type text}, {"Timing", type text}, {"Focus", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
