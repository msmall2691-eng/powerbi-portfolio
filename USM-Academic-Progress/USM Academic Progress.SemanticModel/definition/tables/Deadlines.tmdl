/// Fall 2026 deadlines from the school Google Calendar (Brightspace feeds plus hand-entered MAT 101 / BUS 260 dates).
table Deadlines
	lineageTag: 6b29f556-6097-6567-4d49-2f275ed5aec7

	measure 'Deadline Count' = COUNTROWS(Deadlines)
		formatString: 0
		lineageTag: 53dce875-dfd0-0600-b262-437fa0537e74

	measure Exams = CALCULATE([Deadline Count], Deadlines[Item Type] = "Exam")
		formatString: 0
		lineageTag: a4bab29d-a311-7b9b-2eb7-6680b7a878a6

	measure Quizzes = CALCULATE([Deadline Count], Deadlines[Item Type] = "Quiz")
		formatString: 0
		lineageTag: e0ed8921-14b0-a17a-aee2-63c62154a526

	/// Deadlines on or after today's date (updates on refresh/open).
	measure 'Upcoming Deadlines' = CALCULATE([Deadline Count], Deadlines[Due Date] >= TODAY())
		formatString: 0
		lineageTag: 9e012d5e-efd4-d88a-255d-c641fa0e6d47

	measure 'Next 14 Days' = CALCULATE([Deadline Count], Deadlines[Due Date] >= TODAY(), Deadlines[Due Date] < TODAY() + 14)
		formatString: 0
		lineageTag: d9c56400-66d5-8d61-76bc-996614aeea3c

	/// Most deadlines landing in any single week.
	measure 'Busiest Week Load' = MAXX(VALUES('Date'[Week Start]), [Deadline Count])
		formatString: 0
		lineageTag: 4f45b165-cc87-3dde-022d-5b8caf238020

	/// Deadlines that never reach the Brightspace feed and had to be entered manually.
	measure 'Hand-Tracked Share' = DIVIDE(CALCULATE([Deadline Count], Deadlines[Tracked Via] = "Added by hand"), [Deadline Count])
		formatString: 0%
		lineageTag: 3c9eb314-c072-e0e9-5e5b-9f67fab7801d

	column 'Deadline Key'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 9cc53680-9bea-1cfc-28b4-b07b349d8185
		summarizeBy: none
		sourceColumn: Deadline Key

		annotation SummarizationSetBy = User

	column 'Due Date'
		dataType: dateTime
		formatString: ddd mmm d
		lineageTag: 6a9ed5f5-847a-96a6-c4ba-8395bb692c7f
		summarizeBy: none
		sourceColumn: Due Date

		annotation SummarizationSetBy = User

	column 'Course Code'
		dataType: string
		isHidden
		lineageTag: 6788b053-4a0a-e32a-2eb7-cf85c3c3942d
		summarizeBy: none
		sourceColumn: Course Code

		annotation SummarizationSetBy = User

	column Item
		dataType: string
		lineageTag: 876aebca-29f7-cf84-5db6-47f8beff0fa9
		summarizeBy: none
		sourceColumn: Item

		annotation SummarizationSetBy = User

	column 'Item Type'
		dataType: string
		lineageTag: e756dc32-4682-326c-7fc5-aae698bc6a45
		summarizeBy: none
		sourceColumn: Item Type

		annotation SummarizationSetBy = User

	column 'Tracked Via'
		dataType: string
		lineageTag: 3d39550a-32b1-9d34-af3b-5bdff5563623
		summarizeBy: none
		sourceColumn: Tracked Via

		annotation SummarizationSetBy = User

	partition Deadlines = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Deadline Key", Int64.Type}, {"Due Date", type date}, {"Course Code", type text}, {"Item", type text}, {"Item Type", type text}, {"Tracked Via", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
