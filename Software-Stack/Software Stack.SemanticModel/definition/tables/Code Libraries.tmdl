/// Technologies declared in each project's package.json / requirements.txt.
table 'Code Libraries'
	lineageTag: bfe4b2de-3ce1-fcf0-84aa-dfd76768361e

	measure 'Projects Using' = DISTINCTCOUNT('Code Libraries'[Project])
		formatString: 0
		lineageTag: bc569ea7-6fee-22cc-74fe-bac48b3956ac

	measure Technologies = DISTINCTCOUNT('Code Libraries'[Technology])
		formatString: 0
		lineageTag: c4fd9a3d-374b-aa4e-5a45-653893cd642e

	column Project
		dataType: string
		lineageTag: 9ab3badd-3678-2b6f-8102-b151b05b3cfd
		summarizeBy: none
		sourceColumn: Project

		annotation SummarizationSetBy = User

	column Technology
		dataType: string
		lineageTag: 56fcc2b6-4978-aae6-35ca-63e4369747eb
		summarizeBy: none
		sourceColumn: Technology

		annotation SummarizationSetBy = User

	column Layer
		dataType: string
		lineageTag: 3258734e-78f9-1c2b-0d93-2a904c2ac037
		summarizeBy: none
		sourceColumn: Layer

		annotation SummarizationSetBy = User

	partition 'Code Libraries' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Project", type text}, {"Technology", type text}, {"Layer", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
