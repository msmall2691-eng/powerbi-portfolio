/// Software used across The Maine Cleaning Co, M Studio and school.
table Tools
	lineageTag: 558fa339-57e9-9573-67bb-13e4211940cd

	measure 'Tool Count' = COUNTROWS(Tools)
		formatString: 0
		lineageTag: 25cd0cf4-cc1b-af54-576b-46c17bca498a

	measure 'Tools In Use' = CALCULATE([Tool Count], Tools[Status] IN {"In use", "Setting up", "Being replaced"})
		formatString: 0
		lineageTag: 217e1eb9-60f8-1dd8-3811-b1105a52ced2

	measure 'Tools Retired' = CALCULATE([Tool Count], Tools[Status] IN {"Retired", "Previously used"})
		formatString: 0
		lineageTag: 185dbf9a-dd36-471e-17ee-2493dad4a866

	/// Off-the-shelf tools retired or being retired in favour of the in-house platform.
	measure 'Replaced by BrightBase' = CALCULATE([Tool Count], Tools[Replaced by Own Build] = "Yes")
		formatString: 0
		lineageTag: 097d2ea7-70ca-f5c6-d3a1-67ab490f68b8

	measure Categories = DISTINCTCOUNT(Tools[Category])
		formatString: 0
		lineageTag: 2f010de0-7e95-3733-5e68-fc918e2251a7

	measure 'Planned Tools' = CALCULATE([Tool Count], Tools[Status] = "Planned")
		formatString: 0
		lineageTag: e482bbd5-b8de-023a-4e38-c188108a1e58

	column Tool
		dataType: string
		isKey
		lineageTag: 5efa53c3-4b35-32f0-49e0-8be242f15883
		summarizeBy: none
		sourceColumn: Tool

		annotation SummarizationSetBy = User

	column Category
		dataType: string
		lineageTag: 4c1e56f7-f075-6035-1e3b-7e4818f8c231
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = User

	column 'Used For'
		dataType: string
		lineageTag: 217fef54-679a-c839-2b35-1d82ab79b134
		summarizeBy: none
		sourceColumn: Used For

		annotation SummarizationSetBy = User

	column Role
		dataType: string
		lineageTag: 333e077e-dc3a-c7e0-ef91-273dcc3454ed
		summarizeBy: none
		sourceColumn: Role

		annotation SummarizationSetBy = User

	column Status
		dataType: string
		lineageTag: c714d11d-1834-c197-fb6a-0cbe2f57a206
		summarizeBy: none
		sourceColumn: Status
		sortByColumn: 'Status Order'

		annotation SummarizationSetBy = User

	column 'Status Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d05243d0-435f-3985-4624-8603c91ff0df
		summarizeBy: none
		sourceColumn: Status Order

		annotation SummarizationSetBy = User

	column 'Replaced By'
		dataType: string
		lineageTag: 2cd33253-dad5-7b0b-972a-38bcac549fc3
		summarizeBy: none
		sourceColumn: Replaced By

		annotation SummarizationSetBy = User

	column Since
		dataType: string
		lineageTag: 7ba9ba0c-d3b1-d2d5-115f-128d0628ae0f
		summarizeBy: none
		sourceColumn: Since

		annotation SummarizationSetBy = User

	column Notes
		dataType: string
		lineageTag: 4e90dbb0-7c51-5a20-9f2d-c3a14e2323db
		summarizeBy: none
		sourceColumn: Notes

		annotation SummarizationSetBy = User

	/// Yes when the tool was replaced by BrightBase, the in-house platform.
	column 'Replaced by Own Build'
		dataType: string
		lineageTag: 53bdadf1-31bf-c6a5-0863-c9383b5a2fa2
		summarizeBy: none
		sourceColumn: Replaced by Own Build

		annotation SummarizationSetBy = User

	partition Tools = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Tool", type text}, {"Category", type text}, {"Used For", type text}, {"Role", type text}, {"Status", type text}, {"Status Order", Int64.Type}, {"Replaced By", type text}, {"Since", type text}, {"Notes", type text}, {"Replaced by Own Build", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
