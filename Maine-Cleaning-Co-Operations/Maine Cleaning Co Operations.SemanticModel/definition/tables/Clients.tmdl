/// One row per client. Names removed; keys are anonymized.
table Clients
	lineageTag: f28c91e2-4aa3-f0e5-e1b8-f313fe4c6c06

	measure 'Client Count' = COUNTROWS(Clients)
		formatString: #,0
		lineageTag: edb02037-54bc-8346-0809-c15ee741f11e

	/// Clients whose first Jobber invoice falls in the selected period.
	measure 'New Clients' = VAR s = MIN('Date'[Date]) VAR e = MAX('Date'[Date]) RETURN COUNTROWS(FILTER(Clients, Clients[First Invoice Date] >= s && Clients[First Invoice Date] <= e))
		formatString: #,0
		lineageTag: c7bdd7d9-1de4-7992-7f9f-e14d7681daf6

	measure 'Currently Active Clients' = CALCULATE(COUNTROWS(Clients), Clients[Client Status] = "Active")
		formatString: #,0
		lineageTag: 9be59240-90a4-d7f3-63a6-c8ee63bef921

	/// Share of clients invoiced more than once.
	measure 'Repeat Client Rate' = DIVIDE(COUNTROWS(FILTER(Clients, Clients[Lifetime Invoices] > 1)), COUNTROWS(Clients))
		formatString: 0.0%
		lineageTag: 501e6f28-fb4e-6f83-6524-ee1e3cf9fb91

	measure 'Avg Lifetime Value' = AVERAGE(Clients[Lifetime Revenue])
		formatString: \$#,0
		lineageTag: 0c057cba-eee5-5bdf-3494-439a5861a310

	/// Anonymized client ID (segment prefix + order of first invoice).
	column 'Client Key'
		dataType: string
		isKey
		lineageTag: 74bf461e-7aff-7eae-bc3e-a56f52551ed6
		summarizeBy: none
		sourceColumn: Client Key

		annotation SummarizationSetBy = User

	column Segment
		dataType: string
		lineageTag: 09aedc8a-091f-c83f-967a-23ddb48ca92d
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = User

	/// From the median gap between a client's invoices.
	column 'Service Cadence'
		dataType: string
		lineageTag: f099807b-da16-4e9d-6dc6-610700a8e9b3
		summarizeBy: none
		sourceColumn: Service Cadence

		annotation SummarizationSetBy = User

	column 'First Invoice Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 4bce7337-341f-261f-d017-7457fb0657c8
		summarizeBy: none
		sourceColumn: First Invoice Date

		annotation SummarizationSetBy = User

	/// Year of the client's first invoice in Jobber.
	column 'Cohort Year'
		dataType: int64
		formatString: 0
		lineageTag: fe244855-22a7-dcba-8fbd-2d20ec5f8f91
		summarizeBy: none
		sourceColumn: Cohort Year

		annotation SummarizationSetBy = User

	column 'Last Invoice Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 0455a20b-42fa-df33-e3ef-d796c457c609
		summarizeBy: none
		sourceColumn: Last Invoice Date

		annotation SummarizationSetBy = User

	/// Active = invoiced within 60 days of the latest invoice in the data.
	column 'Client Status'
		dataType: string
		lineageTag: a0fbea2d-00a8-8417-7dfc-baa27545542e
		summarizeBy: none
		sourceColumn: Client Status

		annotation SummarizationSetBy = User

	column 'Lifetime Invoices'
		dataType: int64
		formatString: 0
		lineageTag: 5a7cf565-5159-9fe5-6e2e-32d5de9eb1a7
		summarizeBy: sum
		sourceColumn: Lifetime Invoices

		annotation SummarizationSetBy = User

	column 'Lifetime Revenue'
		dataType: double
		formatString: \$#,0
		lineageTag: e40f1880-a7fb-54b1-9a83-bbf5ec0099b0
		summarizeBy: sum
		sourceColumn: Lifetime Revenue

		annotation SummarizationSetBy = User

	partition Clients = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Client Key", type text}, {"Segment", type text}, {"Service Cadence", type text}, {"First Invoice Date", type date}, {"Cohort Year", Int64.Type}, {"Last Invoice Date", type date}, {"Client Status", type text}, {"Lifetime Invoices", Int64.Type}, {"Lifetime Revenue", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
