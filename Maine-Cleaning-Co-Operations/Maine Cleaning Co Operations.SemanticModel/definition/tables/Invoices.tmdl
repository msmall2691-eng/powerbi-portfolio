/// One row per Jobber invoice, 2023 to present.
table Invoices
	lineageTag: 86343390-b88b-24b8-a7b7-8aa022a45249

	/// Total invoiced amount. Scaled by a constant factor for privacy; ratios and trends are exact.
	measure Revenue = SUM(Invoices[Amount])
		formatString: \$#,0
		lineageTag: c1f39890-fd31-bb3f-e0cf-f18a81b6e777

	measure 'Invoice Count' = COUNTROWS(Invoices)
		formatString: #,0
		lineageTag: 78e137dc-d6a0-08af-a32c-99aa7dc4b171

	measure 'Avg Invoice' = DIVIDE([Revenue], [Invoice Count])
		formatString: \$#,0
		lineageTag: fd3f7567-a726-18b1-c442-e013a708ea2f

	/// Clients invoiced in the selected period.
	measure 'Active Clients' = DISTINCTCOUNT(Invoices[Client Key])
		formatString: #,0
		lineageTag: 20b56d74-f5e8-f214-33e0-28de7c9893fc

	measure 'Revenue per Client' = DIVIDE([Revenue], [Active Clients])
		formatString: \$#,0
		lineageTag: fbebdd98-00ad-7ba5-0315-cb6877b792ec

	/// Revenue for the selected year (latest year if none selected), limited to dates that also have prior-year data.
	measure 'Revenue LFL' = VAR firstD = CALCULATE(MIN(Invoices[Issued Date]), ALL(Invoices)) VAR lastD = CALCULATE(MAX(Invoices[Issued Date]), ALL(Invoices)) VAR yr = IF(HASONEVALUE('Date'[Year]), VALUES('Date'[Year]), YEAR(lastD)) VAR cur = CALCULATETABLE(VALUES('Date'[Date]), 'Date'[Year] = yr, KEEPFILTERS(FILTER(ALL('Date'[Date]), 'Date'[Date] <= lastD && EDATE('Date'[Date], -12) >= firstD))) RETURN CALCULATE([Revenue], cur)
		formatString: \$#,0
		lineageTag: 1d298200-3f5c-3b7a-2db2-a83e73364d54

	/// Same dates one year earlier (like-for-like).
	measure 'Revenue PY' = VAR firstD = CALCULATE(MIN(Invoices[Issued Date]), ALL(Invoices)) VAR lastD = CALCULATE(MAX(Invoices[Issued Date]), ALL(Invoices)) VAR yr = IF(HASONEVALUE('Date'[Year]), VALUES('Date'[Year]), YEAR(lastD)) VAR cur = CALCULATETABLE(VALUES('Date'[Date]), 'Date'[Year] = yr, KEEPFILTERS(FILTER(ALL('Date'[Date]), 'Date'[Date] <= lastD && EDATE('Date'[Date], -12) >= firstD))) RETURN CALCULATE([Revenue], SAMEPERIODLASTYEAR(cur))
		formatString: \$#,0
		lineageTag: 75f670d1-b09e-ddd3-4b7a-962a0442a8f8

	/// Like-for-like growth: selected year (or latest year) vs. the same dates the year before.
	measure 'Revenue YoY %' = VAR py = [Revenue PY] RETURN IF(NOT ISBLANK(py), DIVIDE([Revenue LFL] - py, py))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: cc16995b-2e72-08cc-d55e-e537e4c839e6

	measure 'Revenue YTD' = TOTALYTD([Revenue], 'Date'[Date])
		formatString: \$#,0
		lineageTag: 6b0fabe0-60d7-b724-ddbc-15a5c3fa4502

	measure 'Revenue Rolling 3M' = VAR lastD = CALCULATE(MAX(Invoices[Issued Date]), ALL(Invoices)) RETURN IF(MIN('Date'[Date]) <= lastD, CALCULATE([Revenue], DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -3, MONTH)))
		formatString: \$#,0
		lineageTag: 89c0030f-220a-8ade-565e-d14400a24738

	/// Of the clients invoiced in the same period last year, the share also invoiced this period.
	measure 'Client Retention YoY' = VAR firstD = CALCULATE(MIN(Invoices[Issued Date]), ALL(Invoices)) VAR lastD = CALCULATE(MAX(Invoices[Issued Date]), ALL(Invoices)) VAR yr = IF(HASONEVALUE('Date'[Year]), VALUES('Date'[Year]), YEAR(lastD)) VAR cur = CALCULATETABLE(VALUES('Date'[Date]), 'Date'[Year] = yr, KEEPFILTERS(FILTER(ALL('Date'[Date]), 'Date'[Date] <= lastD && EDATE('Date'[Date], -12) >= firstD))) VAR curC = CALCULATETABLE(VALUES(Invoices[Client Key]), cur) VAR prevC = CALCULATETABLE(VALUES(Invoices[Client Key]), SAMEPERIODLASTYEAR(cur)) RETURN DIVIDE(COUNTROWS(INTERSECT(curC, prevC)), COUNTROWS(prevC))
		formatString: 0.0%
		lineageTag: cd0c85ae-a7c4-b8fc-b525-794e45dc9a87

	/// Revenue concentration: share of revenue from the ten largest clients in the period.
	measure 'Top 10 Client Share' = DIVIDE(SUMX(TOPN(10, VALUES(Invoices[Client Key]), [Revenue]), [Revenue]), [Revenue])
		formatString: 0.0%
		lineageTag: 6e918f1b-1ee1-3a64-3dda-b7a79bc6b966

	measure 'STR Revenue' = CALCULATE([Revenue], Clients[Segment] = "Short-term rental")
		formatString: \$#,0
		lineageTag: 14abdd9a-705a-8236-f27f-c93af32d08a2

	/// Invoices billed to short-term-rental clients (one per turnover in most cases).
	measure 'STR Turnovers' = CALCULATE([Invoice Count], Clients[Segment] = "Short-term rental")
		formatString: #,0
		lineageTag: c32408f8-3a04-bc54-7d5e-ec207e78584d

	measure 'STR Avg Ticket' = DIVIDE([STR Revenue], [STR Turnovers])
		formatString: \$#,0
		lineageTag: 3d63a75a-0403-93b0-d5fc-06de52d9777b

	measure 'STR Properties' = CALCULATE([Active Clients], Clients[Segment] = "Short-term rental")
		formatString: #,0
		lineageTag: 2331151c-d497-05b7-2bf3-9796219aa196

	measure 'STR Share of Revenue' = DIVIDE([STR Revenue], [Revenue])
		formatString: 0.0%
		lineageTag: a2f0101f-16fe-56b0-3c2d-3d8a2d7bce49

	/// Revenue shown only for the 15 largest clients in the current selection.
	measure 'Revenue (Top 15 Clients)' = IF(NOT ISBLANK([Revenue]) && RANKX(ALLSELECTED(Clients[Client Key]), [Revenue]) <= 15, [Revenue])
		formatString: \$#,0
		lineageTag: 9f8a036e-5bc7-139d-5254-9fcdc2b7ca2d

	measure 'STR Revenue (Top 15)' = IF(NOT ISBLANK([STR Revenue]) && RANKX(ALLSELECTED(Clients[Client Key]), [STR Revenue]) <= 15, [STR Revenue])
		formatString: \$#,0
		lineageTag: 2cd3d0e9-251a-f654-06f5-dd2ed24918cb

	measure 'Outstanding Balance' = SUMX(FILTER(Invoices, Invoices[Status] = "Past due"), Invoices[Amount])
		formatString: \$#,0
		lineageTag: c338fbbe-9285-2f5f-9c05-8946a436ff99

	column 'Invoice Key'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 988ddad9-ea0b-ba8f-aa25-a0dba1661f46
		summarizeBy: none
		sourceColumn: Invoice Key

		annotation SummarizationSetBy = User

	column 'Client Key'
		dataType: string
		isHidden
		lineageTag: 3941cca9-b265-d5e9-d4ff-d2471e56ab71
		summarizeBy: none
		sourceColumn: Client Key

		annotation SummarizationSetBy = User

	column 'Issued Date'
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 9ead85f5-6e5b-0fe8-38ec-b6ea2ed99968
		summarizeBy: none
		sourceColumn: Issued Date

		annotation SummarizationSetBy = User

	column Status
		dataType: string
		lineageTag: 78a301e9-7c62-41ae-88f8-4da290883a13
		summarizeBy: none
		sourceColumn: Status

		annotation SummarizationSetBy = User

	column Amount
		dataType: double
		isHidden
		formatString: \$#,0.00
		lineageTag: 03df9482-e7cf-80fa-30b6-337693044683
		summarizeBy: none
		sourceColumn: Amount

		annotation SummarizationSetBy = User

	column 'Ticket Size'
		dataType: string
		lineageTag: d5cc581b-e17a-1392-c50a-a5779eb2112c
		summarizeBy: none
		sourceColumn: Ticket Size
		sortByColumn: 'Ticket Size Order'

		annotation SummarizationSetBy = User

	column 'Ticket Size Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 70491bbd-b795-bc71-050f-7873c74a67db
		summarizeBy: none
		sourceColumn: Ticket Size Order

		annotation SummarizationSetBy = User

	partition Invoices = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Invoice Key", Int64.Type}, {"Client Key", type text}, {"Issued Date", type date}, {"Status", type text}, {"Amount", type number}, {"Ticket Size", type text}, {"Ticket Size Order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
