/// Files changed per commit, grouped by language (from file extension).
table 'File Changes'
	lineageTag: 4f2bf3b4-f3e3-322b-0be3-a42ff60f3656

	/// Files touched, counted once per commit.
	measure 'File Edits' = SUM('File Changes'[Files])
		formatString: #,0
		lineageTag: b8fbdf66-1df2-ebd5-6774-8a5b2e2b6d11

	measure 'Language Share' = DIVIDE([File Edits], CALCULATE([File Edits], ALL('File Changes'[Language])))
		formatString: 0.0%
		lineageTag: 89b16dbd-a2de-ccc7-1d86-2eacdf92053b

	column 'Commit Key'
		dataType: string
		isHidden
		lineageTag: 5eb9a2f0-de7b-4276-f391-eebdda695af4
		summarizeBy: none
		sourceColumn: Commit Key

		annotation SummarizationSetBy = User

	column Language
		dataType: string
		lineageTag: e41defb4-c4da-f0e1-911b-ad3ed814edca
		summarizeBy: none
		sourceColumn: Language

		annotation SummarizationSetBy = User

	column Files
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f974315b-5433-dd47-067a-5c28165f7915
		summarizeBy: none
		sourceColumn: Files

		annotation SummarizationSetBy = User

	partition 'File Changes' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Commit Key", type text}, {"Language", type text}, {"Files", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
