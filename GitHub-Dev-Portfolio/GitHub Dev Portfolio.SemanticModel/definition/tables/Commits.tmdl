/// One row per commit across all repositories (merge and bot commits excluded).
table Commits
	lineageTag: 5ecc1e89-b10a-4a39-0685-6dad8d627299

	/// Non-merge commits, bots excluded.
	measure 'Total Commits' = COUNTROWS(Commits)
		formatString: #,0
		lineageTag: 529ca500-b8e1-aa45-3b7b-4361584f86b3

	/// Days with at least one commit.
	measure 'Active Days' = DISTINCTCOUNT(Commits[Date])
		formatString: #,0
		lineageTag: 96a3ae63-3a35-337f-f736-07fc6a9db4eb

	measure 'Repos Touched' = DISTINCTCOUNT(Commits[Repo])
		formatString: #,0
		lineageTag: 50f77120-2c17-df4b-d283-f37f724f205f

	/// Distinct pull requests referenced by squash-merge commit messages.
	measure 'Pull Requests' = CALCULATE(DISTINCTCOUNT(Commits[PR Key]), NOT ISBLANK(Commits[PR Key]))
		formatString: #,0
		lineageTag: 90f3bcad-7bd8-6b5a-1195-a6728a74c885

	measure Features = CALCULATE([Total Commits], Commits[Commit Type] = "Feature")
		formatString: #,0
		lineageTag: e78253f0-0358-637b-9e61-80eaf0bf94f6

	measure Fixes = CALCULATE([Total Commits], Commits[Commit Type] = "Fix")
		formatString: #,0
		lineageTag: 9f1d8c82-111c-acec-e9f0-4ef83f79e34e

	measure 'Feature Share' = DIVIDE([Features], [Total Commits])
		formatString: 0.0%
		lineageTag: 2ede5452-7893-58b3-9bf4-fde720f25175

	measure 'Commits per Active Day' = DIVIDE([Total Commits], [Active Days])
		formatString: 0.0
		lineageTag: c44e5bdf-be0f-0125-057a-2b9b3b817e23

	measure 'Files Changed (Total)' = SUM(Commits[Files Changed])
		formatString: #,0
		lineageTag: 27c6b2b3-6830-1848-dcbf-f1d39fef1b05

	measure 'First Commit' = MIN(Commits[Date])
		formatString: mmm d, yyyy
		lineageTag: 902effb3-05b1-32c3-93fc-f4d3b28ba32e

	measure 'Last Commit' = MAX(Commits[Date])
		formatString: mmm d, yyyy
		lineageTag: 46494d59-3d29-1a43-e5a5-bdc8994ab5e1

	measure 'Commits Last 30 Days' = VAR LastDay = CALCULATE(MAX(Commits[Date]), ALL(Commits)) RETURN CALCULATE([Total Commits], Commits[Date] > LastDay - 30)
		formatString: #,0
		lineageTag: 408646e2-69e1-b98d-4c09-638b62054c0e

	column 'Commit Key'
		dataType: string
		isHidden
		isKey
		lineageTag: 94e6dac0-7d74-ddc4-771b-19a159ea483f
		summarizeBy: none
		sourceColumn: Commit Key

		annotation SummarizationSetBy = User

	column Repo
		dataType: string
		isHidden
		lineageTag: 58836078-6ab6-fe31-d369-48aa5dbb6f41
		summarizeBy: none
		sourceColumn: Repo

		annotation SummarizationSetBy = User

	column Date
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: de412550-0ff2-12f8-e5da-1ead37f97e80
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

	/// Local hour of day (America/New_York) the commit was made.
	column Hour
		dataType: int64
		formatString: 0
		lineageTag: de8d1653-292b-e7cd-3afa-480d3c13598f
		summarizeBy: none
		sourceColumn: Hour

		annotation SummarizationSetBy = User

	/// Classified from the commit message (feat/fix/... prefixes and leading verbs).
	column 'Commit Type'
		dataType: string
		lineageTag: eeb0c633-d58e-1d65-c71e-3a21998d57c2
		summarizeBy: none
		sourceColumn: Commit Type

		annotation SummarizationSetBy = User

	column 'PR Key'
		dataType: string
		isHidden
		lineageTag: 7961653c-f8e6-e9de-5253-1e744ed92500
		summarizeBy: none
		sourceColumn: PR Key

		annotation SummarizationSetBy = User

	column 'Files Changed'
		dataType: int64
		formatString: 0
		lineageTag: cdee21f7-423c-4109-e4e8-8995aa5bab41
		summarizeBy: sum
		sourceColumn: Files Changed

		annotation SummarizationSetBy = User

	partition Commits = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Commit Key", type text}, {"Repo", type text}, {"Date", type date}, {"Hour", Int64.Type}, {"Commit Type", type text}, {"PR Key", type text}, {"Files Changed", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
