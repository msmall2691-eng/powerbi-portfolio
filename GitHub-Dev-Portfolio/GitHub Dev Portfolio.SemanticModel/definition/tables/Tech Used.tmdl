/// Technologies declared in each repo's dependency files.
table 'Tech Used'
	lineageTag: 08c27fb2-cbc7-675e-533a-2b00da0c7511

	/// Repositories whose package.json or requirements.txt declares this technology.
	measure 'Repos Using' = DISTINCTCOUNT('Tech Used'[Repo])
		formatString: #,0
		lineageTag: 2ea7b3b1-b561-74da-6845-403eab5ec204

	column Repo
		dataType: string
		isHidden
		lineageTag: 38034ac0-89e3-4f2c-fbaf-c4f64f38e036
		summarizeBy: none
		sourceColumn: Repo

		annotation SummarizationSetBy = User

	column Technology
		dataType: string
		lineageTag: 52005dbf-1806-c30c-e83c-10449d795bec
		summarizeBy: none
		sourceColumn: Technology

		annotation SummarizationSetBy = User

	column Layer
		dataType: string
		lineageTag: cb217d6e-07ea-7abf-6f96-dd6f14f7a406
		summarizeBy: none
		sourceColumn: Layer

		annotation SummarizationSetBy = User

	partition 'Tech Used' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Repo", type text}, {"Technology", type text}, {"Layer", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
